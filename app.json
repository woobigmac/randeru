{
  "expo": {
    "name": "randeru",
    "slug": "randeru",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#7C6FD8"
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.randeru.app",
      "buildNumber": "39",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "랜데루는 오늘의 액션을 완료한 사진이나 짧은 영상을 직접 촬영해 기록에 첨부하기 위해 카메라 접근이 필요합니다.",
        "NSMicrophoneUsageDescription": "랜데루는 오늘의 액션을 짧은 영상으로 기록할 때 소리를 함께 저장하기 위해 마이크 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "랜데루는 미션 완료 인증 사진이나 영상을 선택해 기록과 공유 카드에 첨부하기 위해 사진 보관함 접근이 필요합니다. 예: 오늘의 액션을 완료한 사진을 선택해 기록에 남깁니다.",
        "NSPhotoLibraryAddUsageDescription": "랜데루는 미션 완료 공유 이미지를 사진 보관함에 저장하기 위해 권한이 필요합니다. 예: 완료 카드를 갤러리에 저장해 인스타그램에 공유합니다.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFAF6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.randeru.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5402672709504975~1047803063",
          "iosAppId": "ca-app-pub-5402672709504975~8734721397"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "8ce0538653d5ba86b44650f62694d0a9",
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      "./plugins/withKakaoInit",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "41f6859e-deb0-4647-8c80-2d6fc0cd8f15"
      }
    },
    "owner": "woobigmac"
  }
}
